{
  "manifest_version": 3,
  "name": "Next Click Lab",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "A local next-click guessing experiment. Compare visible and hidden predictions.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Next Click Lab", "default_popup": "popup.html"},
  "incognito": "not_allowed"
}
